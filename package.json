{
  "name": "dinostart",
  "version": "1.6.0",
  "private": true,
  "description": "DinoStart — page de nouvel onglet personnelle et synchronisée via un dépôt GitHub privé",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:ui": "vitest run tests/ui",
    "build": "tsc --noEmit && vite build && node scripts/make-variants.mjs",
    "icons": "node scripts/make-icons.mjs",
    "e2e": "python scripts/e2e-chromium.py",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "e2e:home": "python scripts/e2e-chromium.py home"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "lucide-react": "^1.57.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
